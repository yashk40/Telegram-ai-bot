# 1. Telegram Bot Token from @BotFather 
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# 2. Secret Token for Webhook Security 
TELEGRAM_SECRET_TOKEN="RANDOM-NUMBER"

# 3. Workers AI Model ( default: meta-llama)
AI_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# 4. System Prompt instructions for the AI 
SYSTEM_PROMPT="You are a helpful, concise, and smart AI assistant communicating over Telegram. Format your answers neatly using Markdown where appropriate."
  